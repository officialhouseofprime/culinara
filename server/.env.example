# Copy this file to .env and fill in real values. Never commit .env.

# ---- Server ----
PORT=4000
# Public URL of this server (used to build links inside emails)
APP_URL=http://localhost:4000
# Public URL of the frontend site (used for links back to the site in emails)
SITE_URL=http://localhost:4000

# ---- Security ----
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call the API (CORS). Defaults
# to SITE_URL if left blank. Set this to your real production domain(s)
# before going live, e.g.: https://culinara.com,https://www.culinara.com
CORS_ORIGIN=http://localhost:4000

# ---- Rate limiting (optional overrides — sane defaults are built in) ----
# General API ceiling
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# Login / signup / apply / password-reset endpoints
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# Founder admin login only
# ADMIN_RATE_LIMIT_WINDOW_MS=900000
# ADMIN_RATE_LIMIT_MAX=5

# ---- Founder / admin login (for the dashboard) ----
ADMIN_EMAIL=culinarateam@gmail.com
# Generate this with: npm run hash-admin-password -- "YourRealPassword"
# Never put a plain-text password here.
ADMIN_PASSWORD_HASH=

# ---- Outgoing email ----
# Leave both BREVO_API_KEY and SMTP_HOST blank to run in "dev mode": emails
# are printed to the server console instead of sent, so you can test signup/
# verification/reset locally without a real mail provider.
#
# RECOMMENDED for free-tier hosting (Render, Railway free plans, etc): most
# free tiers block outbound SMTP ports (25/465/587) but never block HTTPS,
# so raw SMTP will time out no matter how correctly it's configured. Brevo
# sends over HTTPS instead and is free for up to 300 emails/day.
#   1. Sign up at https://www.brevo.com
#   2. Settings -> Senders & IPs -> add and verify a sender email (your Gmail
#      works fine here, no custom domain needed)
#   3. Settings -> SMTP & API -> API Keys -> generate a new key
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Alternative: traditional SMTP (works locally, and on hosts/plans that
# don't block SMTP ports). Ignored if BREVO_API_KEY is set above.
# Works with Gmail (use an App Password, not your normal password),
# SendGrid, Mailgun, Postmark, Amazon SES, or any SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="CULINARA <hello@culinara.com>"
